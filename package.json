{
  "name": "feredron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FEREDRON — votre commercial IA, partout avec vous.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/vercel-migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import ./scripts/register-paths.mjs --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env --import ./scripts/register-paths.mjs prisma/seed.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.ts",
    "demo:seed": "node --env-file-if-exists=.env --import ./scripts/register-paths.mjs prisma/seed-staging.ts",
    "demo:reset": "node --env-file-if-exists=.env --import ./scripts/register-paths.mjs scripts/demo-reset.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.ts",
    "gen:secrets": "node scripts/gen-secrets.ts",
    "worker": "node --env-file-if-exists=.env scripts/worker.ts",
    "mobile:icons": "node scripts/gen-feredron-icons.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios"
  },
  "prisma": {
    "seed": "node --import ./scripts/register-paths.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^7.120.4",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "libphonenumber-js": "^1.13.12",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prisma": "^6.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
