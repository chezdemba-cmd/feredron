// Djeli's Business Assistant — schéma de données
// Phase 1 : fondations (auth, multi-tenant, RBAC, audit).
// Phase 2 : catalogue, produits, stock (modèles Product* / Stock*).
// Modules métier suivants (commandes, créances, conversations, IA) à venir.

generator client {
  provider = "prisma-client-js"
  // Moteur "library" (défaut, .node chargé en process) : seul chemin fiable sur
  // Vercel/Lambda — le moteur "binary" (exécutable séparé) n'est pas embarqué
  // par le tracing Next, d'où des PrismaClientInitializationError en prod.
  // `native` = poste local ; `rhel-openssl-3.0.x` = runtime Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

