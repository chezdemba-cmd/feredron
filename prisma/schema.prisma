  ADMIN
  MANAGER
  SALES
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum BusinessType {
  WHOLESALE
  RETAIL
  DISTRIBUTION
  IMPORT_EXPORT
  OTHER
}

// ── Phase 2 : catalogue & stock ──

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Unités de vente courantes du commerce. OTHER + unitLabel pour le libre.
enum ProductUnit {
  UNIT
  SAC
  CARTON
  PAQUET
  BIDON
  LITRE
  KG
  BOITE
  BOUTEILLE
  LOT
  PALETTE
  ROULEAU
  OTHER
}

/// `quantity` est TOUJOURS positive ; le sens (±) dépend du type.
/// Delta physique centralisé : voir src/server/stock/movement-rules.ts
///   +  INITIAL, PURCHASE, ADJUSTMENT_IN, RETURN_IN, CANCELLATION
///   -  SALE, ADJUSTMENT_OUT, RETURN_OUT
enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  CANCELLATION
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  EXPIRED
}

enum ReservationSourceType {
  ORDER
  MANUAL
  OTHER
}

