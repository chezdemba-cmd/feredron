# ─────────────────────────────────────────────────────────────
# FEREDRON — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
# NE JAMAIS committer `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL — Supabase / Neon / local, indifférent.
# Exemple local : postgresql://postgres:postgres@localhost:5432/djeli?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/djeli?schema=public"

# Connexion DIRECTE (pas de pooler PgBouncer/Supavisor en mode transaction) —
# OBLIGATOIRE pour `prisma migrate deploy`/`migrate dev` (erreur P1012 sinon).
# Derrière un pooler Supabase : même hôte que DATABASE_URL, port 5432 au lieu
# de 6543, sans `pgbouncer=true`. Sans pooler (local/CI) : identique à
# DATABASE_URL. Sans elle, `prisma migrate deploy` peut rester bloqué
# indéfiniment au lieu d'échouer proprement (le pooler en mode transaction ne
# supporte pas les verrous de session dont Migrate a besoin).
DIRECT_URL="postgresql://user:password@localhost:5432/djeli?schema=public"

# Moteur Prisma. Laisser vide en prod (Vercel/Linux) → moteur "library" par
# défaut. Sur un poste où le .node ne se charge pas (certains Windows), poser
# PRISMA_CLIENT_ENGINE_TYPE=binary en local uniquement.
# PRISMA_CLIENT_ENGINE_TYPE=binary

# Secret de signature des sessions (cookie JWT). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 caractères.
AUTH_SESSION_SECRET="change-me-with-a-long-random-string-min-32-chars"

# Durée de session en jours (optionnel, défaut 30).
AUTH_SESSION_TTL_DAYS="30"

# URL publique de l'application (utilisée pour construire les liens d'invitation).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Défauts organisation (le premier marché est le Mali, non verrouillé).
DEFAULT_COUNTRY_CODE="ML"
DEFAULT_CURRENCY="XOF"
DEFAULT_TIMEZONE="Africa/Bamako"

# Node env (development | test | production) — géré par Next, listé pour info.
# NODE_ENV="development"

# ─────────────────────────────────────────────────────────────
# Phase 5 — WhatsApp Business Cloud API (plateforme Djeli)
# ─────────────────────────────────────────────────────────────
# Provider WhatsApp : "mock" (dev/test, aucun appel Meta) ou "meta" (Cloud API).
# "mock" est REFUSÉ en production sauf WHATSAPP_ALLOW_MOCK_IN_PROD=1.
WHATSAPP_PROVIDER="mock"

# Version de l'API Graph, centralisée (jamais concaténée à la main ailleurs).
META_GRAPH_API_VERSION="v21.0"

# App Meta (plateforme Djeli, pas par organisation).
META_APP_ID=""
META_APP_SECRET=""

# Jeton de vérification du webhook (GET /api/webhooks/whatsapp). Secret.
META_WEBHOOK_VERIFY_TOKEN=""

# Clé de chiffrement des access tokens WhatsApp stockés en base (AES-256-GCM).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_TOKEN_ENCRYPTION_KEY=""

# Autorise explicitement le provider mock en production (déconseillé).
# WHATSAPP_ALLOW_MOCK_IN_PROD="1"

# NB : les credentials PROPRES À CHAQUE ORGANISATION (Phone Number ID, WABA ID,
# access token) sont saisis dans Paramètres → WhatsApp et stockés chiffrés en
# base (modèle WhatsAppConnection). Ne PAS mettre de Phone Number ID global ici.

# ─────────────────────────────────────────────────────────────
# Phase 6 — Djeli IA
# ─────────────────────────────────────────────────────────────
# "mock" (déterministe, aucune API, dev/test) ou "openai-compatible".
AI_PROVIDER="mock"
# Clé API du fournisseur LLM (jamais exposée au frontend, jamais journalisée).
AI_API_KEY=""
# URL de base d'une API compatible OpenAI (chat/completions). Optionnel.
AI_BASE_URL=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="20000"
AI_MAX_TOKENS="700"
# Traitement du job IA après webhook : "inline" (différé in-process) ou "queue".
AI_DISPATCH="inline"
# Garde-fou anti-boucle : réponses AUTO WhatsApp / conversation / minute.
AI_AUTO_MAX_PER_MIN="4"

# ─────────────────────────────────────────────────────────────
# Phase 6B — Djeli Voice (speech-to-text)
# ─────────────────────────────────────────────────────────────
# "mock" (déterministe, sans API — dev/test), "openai-compatible" (Whisper
# OpenAI ou équivalent), "kooma" (STT bambara — https://kooma.ai, recommandé
# vu le volume d'échanges en bambara sur FEREDRON), ou "bambara-hf" (modèle
# bambara auto-hébergé de test, non prod).
VOICE_PROVIDER="mock"
# Clé + URL d'un service compatible OpenAI (/audio/transcriptions). Jamais exposées au frontend.
# Pour "kooma" : VOICE_BASE_URL et VOICE_MODEL ont des défauts corrects
# (https://api.kooma.ai/v1, kooma-stt-1) — seule VOICE_API_KEY est requise.
VOICE_API_KEY=""
VOICE_BASE_URL=""
VOICE_MODEL="whisper-1"
VOICE_TIMEOUT_MS="30000"
VOICE_MAX_FILE_MB="16"
# En dessous de ce seuil de confiance, Djeli IA demande une clarification / handoff.
VOICE_LOW_CONFIDENCE_THRESHOLD="0.55"
# Transcription après webhook : "inline" (différé in-process) ou "queue" (à brancher).
VOICE_DISPATCH="inline"
# NB : politique audio MVP — le binaire n'est PAS conservé (téléchargé, transcrit, jeté).

# ─────────────────────────────────────────────────────────────
# Phase 6C — Djeli Language Core
# ─────────────────────────────────────────────────────────────
# Secret du client API de démo (DJELI_BUSINESS) créé par le seed, pour tester
# /api/v1/language/* en local :  Authorization: Bearer djeli-business.<secret>
# Le connecteur in-process du Business Assistant n'en a PAS besoin.
LANGUAGE_DEMO_CLIENT_SECRET="dev-language-secret-change-me"

# ─────────────────────────────────────────────────────────────
# Phase 6D — Learning Loop (seuils de PROPOSITION, jamais d'auto-promotion)
# ─────────────────────────────────────────────────────────────
LEARNING_MIN_OCCURRENCES="3"
LEARNING_MIN_ORGANIZATIONS="3"
LEARNING_MIN_CORRECTIONS="2"
LEARNING_MIN_CONFIDENCE="0.35"
LEARNING_STALE_DAYS="120"

# ─────────────────────────────────────────────────────────────
# Phase 7 — Automatisations, assistant proactif, marketing
# DETECT → RECOMMEND → PREPARE → CONFIRM → EXECUTE. Rien d'externe en auto.
# ─────────────────────────────────────────────────────────────
# "inline" (passe à la demande), "cron" (route interne), "queue" (via JobQueue).
AUTOMATION_DISPATCH="inline"
# Secret du déclencheur interne : POST /api/internal/automations/run
#   (header x-automation-secret). Idem POST /api/internal/jobs/run.
AUTOMATION_CRON_SECRET=""
# Seuils des détecteurs (surchargés par la config de chaque règle).
AUTOMATION_INACTIVE_CUSTOMER_DAYS="60"
AUTOMATION_RECOMMENDATION_COOLDOWN_HOURS="24"
AUTOMATION_ORDER_PENDING_HOURS="2"
AUTOMATION_ORDER_STUCK_HOURS="48"
PAYMENT_DUE_SOON_DAYS="3"
# Jobs : nombre max de tentatives avant DEAD.
JOB_MAX_ATTEMPTS="3"
# Garde-fou anti-spam : plafond de destinataires par campagne (0 = illimité).
MARKETING_MAX_RECIPIENTS="0"

# ─────────────────────────────────────────────────────────────
# Phase 8 — Production, monétisation, pilote
# ─────────────────────────────────────────────────────────────
# Environnement LOGIQUE de déploiement (indépendant du NODE_ENV de Next).
# En "production", les providers "mock" sont refusés au démarrage sauf
# autorisation explicite ci-dessous.
APP_ENV="development"
AI_ALLOW_MOCK_IN_PROD="0"
VOICE_ALLOW_MOCK_IN_PROD="0"
# Le seed de démonstration ne doit JAMAIS tourner en production.
ALLOW_DEMO_SEED="0"

# Topologie : "single" (pilote — une instance) ou "multi" (plusieurs instances).
# "multi" IMPOSE RATE_LIMIT_STORE=redis (garde-fou de production).
DEPLOYMENT_TOPOLOGY="single"
# Rate-limit : "memory" (mono-instance). "redis" (partagé, multi-instance) est
# prévu mais l'adaptateur n'est PAS encore implémenté — "redis" échoue au
# démarrage en production tant qu'il n'est pas fourni.
RATE_LIMIT_STORE="memory"
REDIS_URL=""
# Tentatives de connexion autorisées par IP et par minute.
LOGIN_RATE_LIMIT_PER_MIN="10"
# Créations de compte autorisées par IP et par minute (anti-abus / anti-énumération).
REGISTER_RATE_LIMIT_PER_MIN="5"

# ─────────────────────────────────────────────────────────────
# E-mail transactionnel (réinitialisation de mot de passe, §R2)
# ─────────────────────────────────────────────────────────────
# "mock" (dev/test : journalise le lien, n'envoie rien) ou "resend" (API REST).
# "mock" est REFUSÉ en production sauf EMAIL_ALLOW_MOCK_IN_PROD=1.
EMAIL_PROVIDER="mock"
# Clé API Resend (jamais exposée au frontend ni journalisée). Requise si "resend".
EMAIL_API_KEY=""
EMAIL_FROM="FEREDRON <no-reply@feredron.app>"
# EMAIL_ALLOW_MOCK_IN_PROD="1"
# Validité d'un lien de réinitialisation (minutes) + limite de demandes / IP / min.
PASSWORD_RESET_TTL_MIN="60"
PASSWORD_RESET_RATE_LIMIT_PER_MIN="5"

# Observabilité.
LOG_LEVEL="info"
# Suivi d'erreurs : DSN Sentry (SDK @sentry/node installé). Vide = logs stdout
# uniquement. Aucune PII transmise (pas de tracing, cookies/headers purgés).
SENTRY_DSN=""

# Monétisation.
TRIAL_DAYS="14"
BILLING_PROVIDER="manual"     # "manual" (pilote) | "stripe" (à brancher)

# Console opérateur Djeli (/admin) — e-mails autorisés, séparés par des virgules.
# (En plus du flag User.isSuperAdmin en base.)
DJELI_SUPERADMIN_EMAILS=""

# Worker de fond (scripts/worker.ts) — lu directement par le script.
WORKER_JOB_INTERVAL_MS="5000"
WORKER_SCHEDULER_INTERVAL_MS="300000"

# ─────────────────────────────────────────────────────────────
# STAGING / DÉMO (seed-staging.ts) — jamais en production
#   APP_ENV=staging   +   npm run demo:seed
# ─────────────────────────────────────────────────────────────
# Mots de passe des comptes de test. Si absents : fallback "demo-djeli-staging".
DEMO_OWNER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
DEMO_MANAGER_PASSWORD=""
DEMO_SALES_PASSWORD=""
DEMO_EMPLOYEE_PASSWORD=""
# Autorise une organisation isDemo à déclencher un envoi externe réel. Défaut : false.
DEMO_ALLOW_EXTERNAL_SEND="false"
# Confirmation obligatoire de `npm run demo:reset` (supprime + recrée l'org démo).
# DEMO_RESET_CONFIRM="DJELI-DEMO"
# URL cible du smoke test (défaut : NEXT_PUBLIC_APP_URL).
# SMOKE_BASE_URL="https://staging.djeli.app"

# ─────────────────────────────────────────────────────────────
# Phase 9 — Mobile / PWA / natif (Capacitor)
# ─────────────────────────────────────────────────────────────
# Feature flags (inlinés au build ; défauts : PWA on, natif/push off)
NEXT_PUBLIC_PWA_ENABLED="1"
NEXT_PUBLIC_MOBILE_NATIVE="0"
NEXT_PUBLIC_PUSH_NOTIFICATIONS="0"
# Web Push (VAPID) — clé publique ; la clé privée reste côté serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Identité de l'app native (§45, §46)
MOBILE_APP_ID="com.feredron.app"
APP_VERSION="0.9.0"
BUILD_NUMBER="1"

# URLs que le shell natif Capacitor peut charger (§91 — jamais localhost en dur)
STAGING_API_URL="https://staging.djeli.app"
PRODUCTION_API_URL="https://app.djeli.io"
# Force l'URL du build Capacitor courant (sinon PRODUCTION puis STAGING).
# CAP_SERVER_URL="https://staging.djeli.app"
